# Backend
MONGO=<your-mongodb-connection-string>
JWT_SECRET=<your-jwt-secret>
PORT=3000

# Cloudinary (image hosting)
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# Frontend URL for CORS (comma-separated for multiple origins)
# In production: CLIENT_URL=https://your-frontend.vercel.app
CLIENT_URL=http://localhost:5173

# Frontend env (in client/.env)
# VITE_API_URL= (leave empty for local dev, set to backend URL in production)
